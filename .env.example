# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Athena
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=eu-west-1
ATHENA_S3_STAGING_DIR=s3://your-bucket/athena-results/
ATHENA_DATABASE=your_database
ATHENA_WORKGROUP=primary

# Database
VNA_DB_PATH=data/vna_alerts.db

# Config
VNA_CONFIG_PATH=config/alerting_rules.yaml

# Slack
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your-app-password
EMAIL_RECIPIENTS=team@yourcompany.com

# Auth (Google OAuth — only needed in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=change-me-in-production
ALLOWED_DOMAIN=adkaora.com

# Frontend
FRONTEND_URL=http://localhost:5173

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
